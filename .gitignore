# ECG Capstone Project - Git Ignore File

# ============================================================================
# Large Data Files (use Google Drive instead)
# ============================================================================

# Downloaded zip files
all_data.zip
mitbih_data.zip

# Raw canine ECG data (download with download_data.py)
Cainine/all_data/

# MIT-BIH ECG data (download with download_data.py)
MITBIH/Data/*.csv
!MITBIH/Data/.gitkeep

# Preprocessed data (generated from raw data)
Cainine/DataPreProcessing/PreProcessedData/*.csv
!Cainine/DataPreProcessing/PreProcessedData/.gitkeep

# Old/duplicate MITBIH input folders (to be removed)
MITBIH/binary_model/input/*.csv
MITBIH/model_arxiv-1805-00794/Data/input/*.csv

